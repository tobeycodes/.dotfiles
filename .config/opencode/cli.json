{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "diffs": {
    "wrap": "word"
  },
  "plugins": [
    "./herdr-tui-session.js",
    "./herdr-opencode"
  ],
  "scroll": {
    "acceleration": true
  },
  "session": {
    "scrollbar": false,
    "sidebar": "auto",
    "thinking": "show"
  },
  "theme": {
    "name": "tokyonight"
  },
  "tabs": {
    "mode": "on",
    "layout": "vertical",
    "indicators": "status"
  }
}
