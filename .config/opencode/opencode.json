{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": false,
  "lsp": true,
  "mcp": {
    "codegraph": {
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
      "type": "local"
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "figma": {
      "enabled": false,
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "grep_app": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "incident": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.incident.io/mcp"
    },
    "linear": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "open-computer-use": {
      "command": ["open-computer-use", "mcp"],
      "enabled": false,
      "type": "local"
    },
    "posthog": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp"
    },
    "resend": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.resend.com/mcp"
    },
    "tablepro": {
      "command": ["/Applications/TablePro.app/Contents/MacOS/tablepro-mcp"],
      "enabled": false,
      "type": "local"
    },
    "uidotsh": {
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:UIDOTSH_TOKEN}"
      },
      "type": "remote",
      "url": "https://ui.sh/mcp?agent=opencode"
    },
    "agentation": {
      "type": "local",
      "command": ["npx", "-y", "agentation-mcp", "server"]
    },
    "agentmail": {
      "type": "remote",
      "url": "https://mcp.agentmail.to/mcp",
      "headers": {
        "x-api-key": "{env:AGENTMAIL_API_KEY}"
      }
    }
  },
  "plugin": ["@plannotator/opencode@latest"],
  "provider": {
    "ollama": {
      "models": {
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  },
  "share": "disabled"
}
