{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": false,
  "lsp": true,
  "mcp": {
    "codegraph": {
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "figma": {
      "enabled": false,
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "grep_app": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "incident": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.incident.io/mcp"
    },
    "linear": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "posthog": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp"
    },
    "tablepro": {
      "command": [
        "/Applications/TablePro.app/Contents/MacOS/tablepro-mcp"
      ],
      "enabled": false,
      "type": "local"
    },
    "uidotsh": {
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:UIDOTSH_TOKEN}"
      },
      "type": "remote",
      "url": "https://ui.sh/mcp?agent=opencode"
    }
  },
  "plugin": [
    "@plannotator/opencode@latest"
  ],
  "provider": {
    "ollama": {
      "models": {
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  },
  "share": "disabled"
}