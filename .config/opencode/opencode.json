{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "servers": {
      "agentation": {
        "command": [
          "npx",
          "-y",
          "agentation-mcp",
          "server"
        ],
        "disabled": true,
        "type": "local"
      },
      "agentmail": {
        "disabled": true,
        "headers": {
          "x-api-key": "{env:AGENTMAIL_API_KEY}"
        },
        "type": "remote",
        "url": "https://mcp.agentmail.to/mcp"
      },
      "cloudflare": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "codegraph": {
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "type": "local"
      },
      "context7": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "figma": {
        "disabled": true,
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp"
      },
      "grep_app": {
        "disabled": false,
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "incident": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.incident.io/mcp"
      },
      "linear": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "open-computer-use": {
        "command": [
          "open-computer-use",
          "mcp"
        ],
        "disabled": true,
        "type": "local"
      },
      "posthog": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp"
      },
      "resend": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.resend.com/mcp"
      },
      "tablepro": {
        "command": [
          "/Applications/TablePro.app/Contents/MacOS/tablepro-mcp"
        ],
        "disabled": true,
        "type": "local"
      },
      "temporal": {
        "command": [
          "/opt/homebrew/bin/uvx",
          "temporal-mcp-server",
          "--host",
          "localhost:7233",
          "--namespace",
          "default"
        ],
        "disabled": true,
        "type": "local"
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/code/tobeycodes/.dotfiles/.agents/skills/*"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "~/code/tobeycodes/.dotfiles/.agents/skills/*"
    }
  ],
  "plugins": [
    "@plannotator/opencode@latest"
  ],
  "share": "disabled",
  "shell": "/opt/homebrew/bin/fish",
  "update": "disable"
}
